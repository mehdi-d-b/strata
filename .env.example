# Copie ce fichier en .env et CHANGE les valeurs avant tout déploiement.
# .env est ignoré par git (jamais commité) ; .env.example sert de modèle.

# TimescaleDB — identifiants de la base.
TIMESCALE_USER=strata
TIMESCALE_PASSWORD=change-me-en-prod
TIMESCALE_DB=strata

# Mot de passe du compte « admin » créé au tout premier démarrage.
# ⚠️ À changer ABSOLUMENT en prod (et idéalement via l'UI après le 1er login).
ADMIN_PASSWORD=change-me-en-prod

# Secret du compte technique lecture seule utilisé exclusivement par ai-service.
# Ne pas réutiliser ADMIN_PASSWORD.
AI_SERVICE_PASSWORD=change-me-en-prod-assistant
